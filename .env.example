# ============ Wajib diisi (Vercel > Project > Settings > Environment Variables) ============

# MongoDB Atlas connection string
MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# Nama database di Atlas
DB_NAME="laporan_stok_sca"

# Kunci penandatangan JWT (buat acak: openssl rand -hex 32)
JWT_SECRET="ganti-dengan-string-acak-64-karakter"

# ============ Superadmin default (dipakai saat seed pertama) ============
SUPERADMIN_USERNAME="Jeffsca"
SUPERADMIN_PASSWORD="ganti-di-produksi"

# Password akses sementara untuk Admin/PIC membuka section terkunci
TEMP_ACCESS_PASSWORD="ganti-di-produksi"
OWNER_EMAIL=""

# ============ Cloudflare R2 (foto bukti tahap PO Tracker) ============
# Dapatkan dari Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret"
R2_BUCKET_NAME="sca-po-photos"
# Public URL bucket (aktifkan Public R2.dev URL di dashboard, atau connect custom domain)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxx.r2.dev"

# Kosongkan bila API berada pada origin yang sama (default untuk Vercel)
# NEXT_PUBLIC_API_BASE="/api"
